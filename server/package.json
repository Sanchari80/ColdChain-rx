{
  "name": "coldchain-rx-server",
  "version": "1.0.0",
  "private": true,
  "description": "HL7 FHIR + RxNorm + HL7 v2 pharmacy cold-chain service for inpatient (IPD) medication delivery",
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "rxnorm:refresh": "node scripts/refresh-rxnorm.js",
    "check": "node scripts/syntax-check.js"
  },
  "dependencies": {
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "express-rate-limit": "7.4.1",
    "helmet": "7.2.0",
    "hl7-standard": "1.0.4",
    "zod": "3.23.8"
  }
}
