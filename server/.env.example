# Copy to .env and edit. Every value below is optional; the defaults run the
# full demo offline with no internet and no hospital systems involved.

PORT=4000
HOST=0.0.0.0

# mock  = in-memory FHIR store + bundled RxNorm snapshot. Nothing leaves this machine.
# live  = talk to a real FHIR server and to the NIH/NLM RxNav API.
DATA_MODE=mock

# Only read when DATA_MODE=live.
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
# FHIR_TOKEN=
RXNAV_BASE_URL=https://rxnav.nlm.nih.gov/REST

# Refrigerated window enforced on every trip.
COLD_MIN_C=2
COLD_MAX_C=8
COLD_SAMPLE_SECONDS=15

# Change both of these before running anywhere real. The server refuses to
# start in production while they are still the development values.
AUTH_SECRET=coldchain-dev-secret-change-me
PHI_PSEUDONYM_SALT=coldchain-dev-pseudonym-salt
AUTH_TTL_SECONDS=28800
# Failed sign-ins allowed per network address in 10 minutes.
AUTH_LOGIN_ATTEMPTS=30
# Wrong PINs before an account locks, and how long it stays locked.
AUTH_MAX_FAILED_ATTEMPTS=10
AUTH_LOCKOUT_MINUTES=3

LOG_LEVEL=info

# Demo mode ships illustrative staff accounts and seeded data for evaluation.
# Set DEMO_MODE=false and load real accounts from your identity store before
# any real deployment. The mobile UI never exposes demo credentials.
DEMO_MODE=true
